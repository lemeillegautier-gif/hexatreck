<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HexaTrek — Suivi de Randonnée</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
  :root {
    --ink: #1a1208;
    --paper: #f5f0e8;
    --aged: #e8dfc8;
    --accent: #c45e1a;
    --muted: #8a7a62;
    --highlight: #2d5a3d;
    --line: #c45e1a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'DM Mono', monospace;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    padding: 2rem 3rem 1.5rem;
    border-bottom: 1px solid var(--muted);
    display: flex;
    align-items: baseline;
    gap: 2rem;
    background: var(--paper);
    position: relative;
    z-index: 1000;
  }

  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .logo span {
    color: var(--accent);
    font-style: italic;
  }

  .meta {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .controls {
    padding: 1.2rem 3rem;
    background: var(--aged);
    border-bottom: 1px solid var(--muted);
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1000;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  input[type="date"], input[type="number"] {
    background: var(--paper);
    border: 1px solid var(--muted);
    color: var(--ink);
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    padding: 0.4rem 0.7rem;
    outline: none;
    transition: border-color 0.2s;
  }

  input[type="date"]:focus, input[type="number"]:focus {
    border-color: var(--accent);
  }

  input[type="number"] {
    width: 70px;
  }

  .divider {
    width: 1px;
    height: 30px;
    background: var(--muted);
    opacity: 0.4;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-value {
    font-size: 1rem;
    font-weight: 400;
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  #map-container {
    flex: 1;
    position: relative;
    min-height: 500px;
  }

  #map {
    width: 100%;
    height: calc(100vh - 180px);
    min-height: 500px;
  }

  /* Tooltip flottant */
  #hover-tooltip {
    position: absolute;
    background: var(--ink);
    color: var(--paper);
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    padding: 0.6rem 1rem;
    pointer-events: none;
    z-index: 2000;
    display: none;
    white-space: nowrap;
    border-left: 3px solid var(--accent);
  }

  #hover-tooltip .tt-date {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
    display: block;
    margin-bottom: 0.2rem;
  }

  #hover-tooltip .tt-sub {
    color: var(--aged);
    font-size: 0.68rem;
  }

  /* Marqueur position actuelle */
  .position-marker {
    width: 14px;
    height: 14px;
    background: var(--accent);
    border: 2px solid var(--paper);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--accent);
  }

  .leaflet-tile-pane { filter: sepia(20%) saturate(80%); }

  /* Info bar en bas */
  #infobar {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    color: var(--paper);
    font-family: 'DM Mono', monospace;
    font-size: 0.78rem;
    padding: 0.7rem 1.5rem;
    z-index: 1000;
    display: flex;
    gap: 2rem;
    align-items: center;
    border-top: 2px solid var(--accent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  #infobar.visible { opacity: 1; }

  #infobar .ib-date {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--accent);
    font-style: italic;
  }

  .ib-sep { color: var(--muted); }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--aged); }
  ::-webkit-scrollbar-thumb { background: var(--muted); }
</style>
</head>
<body>

<header>
  <div class="logo">Hexa<span>Trek</span></div>
  <div class="meta">3 011 km &nbsp;·&nbsp; Alsace → Pays Basque &nbsp;·&nbsp; GR traversée des Alpes, Jura, Vosges</div>
</header>

<div class="controls">
  <div class="control-group">
    <label>Départ</label>
    <input type="date" id="startDate" value="2025-06-01">
  </div>
  <div class="control-group">
    <label>km/jour</label>
    <input type="number" id="kmPerDay" value="25" min="5" max="60" step="1">
  </div>
  <div class="divider"></div>
  <div class="control-group">
    <label>Chercher une date</label>
    <input type="date" id="searchDate" placeholder="jj/mm/aaaa">
  </div>
  <div class="divider"></div>
  <div class="stat">
    <div class="stat-value" id="totalDays">—</div>
    <div class="stat-label">Jours de marche</div>
  </div>
  <div class="stat">
    <div class="stat-value" id="arrivalDate">—</div>
    <div class="stat-label">Arrivée estimée</div>
  </div>
</div>

<div id="map-container">
  <div id="map"></div>
  <div id="hover-tooltip">
    <span class="tt-date" id="tt-date"></span>
    <span class="tt-sub" id="tt-sub"></span>
  </div>
  <div id="infobar">
    <span class="ib-date" id="ib-date"></span>
    <span class="ib-sep">·</span>
    <span id="ib-km"></span>
    <span class="ib-sep">·</span>
    <span id="ib-day"></span>
  </div>
</div>

