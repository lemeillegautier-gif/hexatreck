43.34119,"lon":-1.74063,"km":3004.52},{"lat":43.34382,"lon":-1.74053,"km":3005.03},{"lat":43.34591,"lon":-1.74298,"km":3005.55},{"lat":43.34864,"lon":-1.74267,"km":3006.07},{"lat":43.35084,"lon":-1.74799,"km":3006.59},{"lat":43.35359,"lon":-1.75227,"km":3007.1},{"lat":43.35593,"lon":-1.75746,"km":3007.63},{"lat":43.35943,"lon":-1.75976,"km":3008.14},{"lat":43.35856,"lon":-1.766,"km":3008.69},{"lat":43.35931,"lon":-1.77173,"km":3009.2},{"lat":43.36335,"lon":-1.77275,"km":3009.71},{"lat":43.36709,"lon":-1.77118,"km":3010.26},{"lat":43.37079,"lon":-1.77345,"km":3010.78},{"lat":43.37328,"lon":-1.77401,"km":3011.09}];

// State
let startDate = new Date('2025-06-01');
let kmPerDay = 25;
const totalKm = TRACK[TRACK.length - 1].km;

// Init map
const map = L.map('map', {
  center: [46.5, 4.5],
  zoom: 6,
  zoomControl: true
});

L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
  attribution: '© OpenTopoMap contributors',
  maxZoom: 17
}).addTo(map);

// Draw track
const latLngs = TRACK.map(p => [p.lat, p.lon]);
const polyline = L.polyline(latLngs, {
  color: '#c45e1a',
  weight: 2.5,
  opacity: 0.85
}).addTo(map);

map.fitBounds(polyline.getBounds(), { padding: [30, 30] });

// Start marker
const startIcon = L.divIcon({
  className: '',
  html: '<div style="width:10px;height:10px;background:#2d5a3d;border:2px solid #f5f0e8;border-radius:50%;"></div>',
  iconAnchor: [5, 5]
});
L.marker([TRACK[0].lat, TRACK[0].lon], {icon: startIcon}).addTo(map)
  .bindTooltip('Départ', {permanent: false, direction: 'right'});

// End marker
const endIcon = L.divIcon({
  className: '',
  html: '<div style="width:10px;height:10px;background:#1a1208;border:2px solid #f5f0e8;border-radius:50%;"></div>',
  iconAnchor: [5, 5]
});
L.marker([TRACK[TRACK.length-1].lat, TRACK[TRACK.length-1].lon], {icon: endIcon}).addTo(map)
  .bindTooltip('Arrivée', {permanent: false, direction: 'left'});

// Position marker (movable)
const posIcon = L.divIcon({
  className: '',
  html: '<div class="position-marker"></div>',
  iconAnchor: [7, 7]
});
let posMarker = null;

// Helpers
function addDays(date, days) {
  const d = new Date(date);
  d.setDate(d.getDate() + days);
  return d;
}

function formatDate(d) {
  return d.toLocaleDateString('fr-FR', {weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'});
}

function formatDateShort(d) {
  return d.toLocaleDateString('fr-FR', {day: 'numeric', month: 'short', year: 'numeric'});
}

function kmToPoint(km) {
  // Binary search
  let lo = 0, hi = TRACK.length - 1;
  while (lo < hi - 1) {
    const mid = (lo + hi) >> 1;
    if (TRACK[mid].km <= km) lo = mid;
    else hi = mid;
  }
  // Interpolate
  const a = TRACK[lo], b = TRACK[hi];
  if (b.km === a.km) return {lat: a.lat, lon: a.lon, km};
  const t = (km - a.km) / (b.km - a.km);
  return {
    lat: a.lat + t * (b.lat - a.lat),
    lon: a.lon + t * (b.lon - a.lon),
    km
  };
}

function dateToKm(date) {
  const msPerDay = 86400000;
  const days = Math.floor((date - startDate) / msPerDay);
  return Math.min(Math.max(days * kmPerDay, 0), totalKm);
}

function kmToDate(km) {
  const days = km / kmPerDay;
  return addDays(startDate, days);
}

function updateStats() {
  const days = Math.ceil(totalKm / kmPerDay);
  const arrival = addDays(startDate, days);
  document.getElementById('totalDays').textContent = days + ' j';
  document.getElementById('arrivalDate').textContent = formatDateShort(arrival);
}

function showPositionForDate(date) {
  const km = dateToKm(date);
  if (km < 0 || km > totalKm) {
    if (posMarker) { posMarker.remove(); posMarker = null; }
    document.getElementById('infobar').classList.remove('visible');
    return;
  }
  const pt = kmToPoint(km);
  if (!posMarker) {
    posMarker = L.marker([pt.lat, pt.lon], {icon: posIcon}).addTo(map);
  } else {
    posMarker.setLatLng([pt.lat, pt.lon]);
  }
  map.panTo([pt.lat, pt.lon], {animate: true, duration: 0.5});

  const days = Math.floor(km / kmPerDay);
  document.getElementById('ib-date').textContent = formatDate(date);
  document.getElementById('ib-km').textContent = Math.round(km) + ' km parcourus';
  document.getElementById('ib-day').textContent = 'Jour ' + (days + 1);
  document.getElementById('infobar').classList.add('visible');
}

// Hover on map
const tooltip = document.getElementById('hover-tooltip');
const mapContainer = document.getElementById('map-container');

map.on('mousemove', function(e) {
  // Find closest point on track
  const latlng = e.latlng;
  let minDist = Infinity;
  let closest = null;
  
  // Sample every 5th point for performance
  for (let i = 0; i < TRACK.length; i += 3) {
    const p = TRACK[i];
    const dlat = p.lat - latlng.lat;
    const dlon = p.lon - latlng.lng;
    const d = dlat*dlat + dlon*dlon;
    if (d < minDist) {
      minDist = d;
      closest = p;
    }
  }
  
  // Only show if close enough (~5km tolerance in degrees ≈ 0.045)
  if (!closest || Math.sqrt(minDist) > 0.25) {
    tooltip.style.display = 'none';
    return;
  }

  const date = kmToDate(closest.km);
  const days = Math.floor(closest.km / kmPerDay);
  
  document.getElementById('tt-date').textContent = formatDate(date);
  document.getElementById('tt-sub').textContent = 
    Math.round(closest.km) + ' km · Jour ' + (days + 1);

  // Position tooltip
  const containerPoint = map.latLngToContainerPoint(e.latlng);
  tooltip.style.left = (containerPoint.x + 15) + 'px';
  tooltip.style.top = (containerPoint.y - 30) + 'px';
  tooltip.style.display = 'block';
});

map.on('mouseout', function() {
  tooltip.style.display = 'none';
});

// Date search
document.getElementById('searchDate').addEventListener('change', function() {
  const val = this.value;
  if (!val) return;
  const date = new Date(val);
  showPositionForDate(date);
});

// Start date change
document.getElementById('startDate').addEventListener('change', function() {
  startDate = new Date(this.value);
  updateStats();
  // Re-trigger search if active
  const sd = document.getElementById('searchDate').value;
  if (sd) showPositionForDate(new Date(sd));
});

// km/day change  
document.getElementById('kmPerDay').addEventListener('change', function() {
  kmPerDay = parseFloat(this.value) || 25;
  updateStats();
  const sd = document.getElementById('searchDate').value;
  if (sd) showPositionForDate(new Date(sd));
});

// Click on map
map.on('click', function(e) {
  const latlng = e.latlng;
  let minDist = Infinity;
  let closest = null;
  for (let i = 0; i < TRACK.length; i++) {
    const p = TRACK[i];
    const dlat = p.lat - latlng.lat;
    const dlon = p.lon - latlng.lng;
    const d = dlat*dlat + dlon*dlon;
    if (d < minDist) { minDist = d; closest = p; }
  }
  if (!closest || Math.sqrt(minDist) > 0.25) return;
  
  const date = kmToDate(closest.km);
  const days = Math.floor(closest.km / kmPerDay);

  if (!posMarker) {
    posMarker = L.marker([closest.lat, closest.lon], {icon: posIcon}).addTo(map);
  } else {
    posMarker.setLatLng([closest.lat, closest.lon]);
  }

  document.getElementById('ib-date').textContent = formatDate(date);
  document.getElementById('ib-km').textContent = Math.round(closest.km) + ' km parcourus';
  document.getElementById('ib-day').textContent = 'Jour ' + (days + 1);
  document.getElementById('infobar').classList.add('visible');
});

// Init
updateStats();
</script>
